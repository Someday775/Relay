{
  "name": "relay-task-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "lint": "eslint cypress cypress.config.ts quality",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write cypress cypress.config.ts quality",
    "test:e2e": "node quality/run.mjs",
    "report:compare": "node quality/compare.mjs"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "2.2.8",
    "@types/node": "24.19.2",
    "cypress": "16.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "pdfkit": "0.21.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
